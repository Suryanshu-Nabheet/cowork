---
import { AUTHOR_NAME, AUTHOR_URL, CHANGELOG_URL, DOCS_URL, GITHUB_URL } from "../site";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo />
    <span class="site-footer__legal">
      © 2026 ·
      <a href={AUTHOR_URL} target="_blank" rel="noreferrer">{AUTHOR_NAME}</a>
      · MIT License
    </span>
  </div>
  <nav class="site-footer__links" aria-label="Footer">
    <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
    <a href={DOCS_URL} target="_blank" rel="noreferrer">Docs</a>
    <a href={CHANGELOG_URL} target="_blank" rel="noreferrer">Changelog</a>
    <a href="/privacy">Privacy</a>
  </nav>
</footer>
